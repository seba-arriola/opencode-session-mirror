#!/usr/bin/env python3
"""
opencode-mirror — list, inspect and restore sessions backed up by the session-mirror
plugin (OpenCode V2).

Snapshots live in ~/.local/share/opencode-mirror/<sessionID>.snapshot.json in the
{ info, messages } shape accepted by `opencode session import`.

Usage:
  opencode-mirror list                 Table of mirrored sessions
  opencode-mirror status               Summary + mirror git state
  opencode-mirror verify [<id>]        Validate snapshots (info + messages structure)
  opencode-mirror restore <id> [opts]  Re-import one session
  opencode-mirror restore-all [opts]   Re-import every session
  opencode-mirror log <id>             Tail the event journal of a session
  opencode-mirror git-log              Commit history of the mirror
  opencode-mirror commit               Force a git checkpoint

restore options:
  --new-ids        Generate fresh IDs (session and messages) instead of keeping the
                   originals. Required if the original session still exists in the DB.
  --dir DIR        Import target directory (default: the snapshot's original directory).
  --dry-run        Do not import; just show what would be done.
  --force          Import even if the session already exists in the DB (may leave a
                   collided copy; prefer --new-ids).

Notes:
  Snapshots are stored in the shape `opencode session import` consumes. Importing a
  session that already exists needs --new-ids: it remaps every msg_/prt_ token and the
  session id, avoiding the `session_message` primary-key collision.
"""
import argparse
import json
import os
import random
import re
import string
import subprocess
import sys
import tempfile
from datetime import datetime

ROOT = os.path.expanduser("~/.local/share/opencode-mirror")
INDEX = os.path.join(ROOT, "index.json")


def die(msg, code=1):
    print(f"ERROR: {msg}", file=sys.stderr)
    sys.exit(code)


def load_index():
    try:
        with open(INDEX) as f:
            return json.load(f)
    except FileNotFoundError:
        return {}
    except Exception as e:
        die(f"could not read {INDEX}: {e}")


def snap_path(sid):
    return os.path.join(ROOT, f"{sid}.snapshot.json")


def human_size(n):
    for u in ("B", "KB", "MB", "GB"):
        if n < 1024:
            return f"{n:.0f}{u}"
        n /= 1024
    return f"{n:.0f}TB"


def human_time(ms):
    if not ms:
        return "-"
    try:
        return datetime.fromtimestamp(ms / 1000).strftime("%Y-%m-%d %H:%M")
    except Exception:
        return "-"


def new_id(prefix, n):
    return prefix + "".join(random.choice(string.ascii_letters + string.digits) for _ in range(n))


def remap_ids(raw):
    """
    Return (raw_with_new_ids, count) remapping every id-like token in the JSON.

    Both `msg_*` and `prt_*` IDs must be remapped: `opencode session import` persists
    messages/parts and the V2 projector writes rows keyed by these IDs into
    `session_message`, so keeping the originals collides with the live session
    (`UNIQUE constraint failed: session_message.id`).
    """
    tokens = sorted(set(re.findall(r"(?:msg_|prt_)[A-Za-z0-9]+", raw)))
    for old in tokens:
        raw = raw.replace(old, new_id("msg_" if old.startswith("msg_") else "prt_", 21))
    return raw, len(tokens)


# ---------------------------------------------------------------------------
# Snapshot shape
#
# This build's `opencode session import` validates each message against the V2
# `Session.Message.Info` schema, i.e. the SAME shape that `ctx.session.context()`
# returns. So snapshots are imported AS-IS; the only conversion needed is ID
# remapping when the session already exists (to avoid `session_message` PK
# collisions). See `remap_ids`.
# ---------------------------------------------------------------------------


def snapshot_stats(data):
    """Return basic counts for a snapshot, for transparent reporting."""
    msgs = data.get("messages") or []
    parts = 0
    for m in msgs:
        if isinstance(m, dict):
            if isinstance(m.get("parts"), list):
                parts += len(m["parts"])
            elif isinstance(m.get("content"), list):
                parts += len(m["content"])
    return {"messages": len(msgs), "parts": parts}


def adapt_v2_to_v1(data):
    """
    Kept for backward compatibility. In this OpenCode build the import command
    consumes the V2 message shape directly, so no structural conversion is done:
    the snapshot is returned unchanged.
    """
    return data, {"already_v1": True, **snapshot_stats(data)}




# ---------------------------------------------------------------------------
# DB probing: does the session already exist?
# ---------------------------------------------------------------------------

def session_exists(sid, directory=None):
    """
    Return True if <sid> is already in the OpenCode DB, False if not, None if the
    check could not be performed (opencode unavailable or output unparsable).

    `opencode session list` is project-scoped, so the query must run in the
    snapshot's original directory (passed here as `directory`).
    """
    cwd = directory if directory and os.path.isdir(directory) else None
    try:
        r = subprocess.run(
            ["opencode", "session", "list", "--format", "json"],
            capture_output=True, text=True, timeout=60, cwd=cwd)
    except Exception:
        return None
    if r.returncode != 0:
        return None
    try:
        rows = json.loads(r.stdout or "[]")
    except Exception:
        return None
    if isinstance(rows, dict):
        rows = rows.get("data") or rows.get("sessions") or []
    if not isinstance(rows, list):
        return None
    return any(isinstance(x, dict) and x.get("id") == sid for x in rows)



def cmd_list(args):
    idx = load_index()
    if not idx:
        print("(no mirrored sessions yet)")
        return 0
    rows = sorted(idx.values(), key=lambda r: r.get("updated") or 0, reverse=True)
    print(f"{'session':32} {'msgs':>5} {'updated':16} title")
    print("-" * 100)
    for r in rows:
        p = snap_path(r["id"])
        size = human_size(os.path.getsize(p)) if os.path.exists(p) else "-"
        print(f"{r['id']:32} {r.get('messages', '?'):>5} {human_time(r.get('updated')):16} "
              f"{(r.get('title') or '')[:44]}  [{size}]")
    return 0


def cmd_status(args):
    idx = load_index()
    total = 0
    for r in idx.values():
        p = snap_path(r["id"])
        if os.path.exists(p):
            total += os.path.getsize(p)
    print(f"mirror        : {ROOT}")
    print(f"sessions      : {len(idx)}")
    print(f"snapshot size : {human_size(total)}")
    last = max((r.get("updated") or 0 for r in idx.values()), default=0)
    print(f"last flush    : {human_time(last)}")
    if os.path.isdir(os.path.join(ROOT, ".git")):
        try:
            out = subprocess.run(["git", "-C", ROOT, "log", "-1", "--format=%h %ci %s"],
                                 capture_output=True, text=True, timeout=10).stdout.strip()
            print(f"last commit   : {out or '(no commits)'}")
        except Exception as e:
            print(f"last commit   : (error: {e})")
    else:
        print("last commit   : (no git repo)")
    return 0


def cmd_verify(args):
    idx = load_index()
    targets = [args.id] if args.id else list(idx.keys())
    bad = 0
    for sid in targets:
        p = snap_path(sid)
        if not os.path.exists(p):
            print(f"MISSING  {sid}")
            bad += 1
            continue
        try:
            d = json.load(open(p))
            ok = isinstance(d.get("info"), dict) and isinstance(d.get("messages"), list)
            print(f"{'OK ' if ok else 'BAD'}      {sid}  info={bool(d.get('info'))} messages={len(d['messages'])}")
            if not ok:
                bad += 1
        except Exception as e:
            print(f"BAD      {sid}  ({e})")
            bad += 1
    return 1 if bad else 0


def do_restore(sid, new_ids, directory, dry_run, force=False):
    p = snap_path(sid)
    if not os.path.exists(p):
        print(f"ERROR: no snapshot for {sid}", file=sys.stderr)
        return 1

    try:
        data = json.load(open(p))
    except Exception as e:
        print(f"ERROR: invalid snapshot for {sid}: {e}", file=sys.stderr)
        return 1

    # Resolve the target directory early: `session list` is project-scoped, so the
    # existence probe must run there.
    snap_dir = (data.get("info", {}).get("location", {}) or {}).get("directory")
    dest = directory or snap_dir
    if not dest or not os.path.isdir(dest):
        dest = os.path.expanduser("~")

    # --- 1) detect collision BEFORE touching the DB -------------------------
    exists = session_exists(sid, snap_dir or dest)
    if exists is True and not new_ids and not force:
        print(f"FAILED {sid}: session already exists in the OpenCode DB.", file=sys.stderr)
        print("  Re-run with --new-ids to import it as a copy,", file=sys.stderr)
        print("  or --force to attempt the import anyway.", file=sys.stderr)
        return 1
    if exists is None and not new_ids and not force:
        print(f"  warning: could not query the DB for {sid}; importing as-is", file=sys.stderr)
    if exists is True and new_ids:
        print("  note: session already exists -> importing a copy with fresh IDs")

    # --- 2) snapshot stats (shape is imported as-is) ------------------------
    stats = snapshot_stats(data)
    print(f"  snapshot: {stats['messages']} messages, {stats['parts']} parts")

    # --- 3) optional ID remap ----------------------------------------------
    if new_ids:
        raw = json.dumps(data)
        raw, n = remap_ids(raw)
        data = json.loads(raw)
        data["info"]["id"] = new_id("ses_", 26)
        data["info"].pop("parentID", None)
        print(f"  remapped IDs: session -> {data['info']['id']}, {n} id tokens")

    if dry_run:
        print(f"  [dry-run] would import {sid} -> {dest}")
        return 0

    with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as tf:
        tf.write(json.dumps(data))
        tmp = tf.name
    try:
        r = subprocess.run(["opencode", "session", "import", tmp, "--directory", dest],
                           capture_output=True, text=True)
        out = (r.stdout + r.stderr).strip()
        if r.returncode == 0:
            print(f"  restored {sid} -> {dest}")
            print(f"    {out.splitlines()[-1] if out else 'ok'}")
            return 0
        # --- 4) actionable error reporting ---------------------------------
        last = out.splitlines()[-1] if out else "error"
        if "session_message" in out and "UNIQUE constraint failed" in out:
            print(f"  FAILED {sid}: message IDs collide in the DB (session_message.id).", file=sys.stderr)
            print("  Use --new-ids to import a copy with fresh message IDs.", file=sys.stderr)
        else:
            print(f"  FAILED {sid}: {last}", file=sys.stderr)
        return 1
    finally:
        os.unlink(tmp)


def cmd_restore(args):
    return do_restore(args.id, args.new_ids, args.dir, args.dry_run, args.force)


def cmd_restore_all(args):
    idx = load_index()
    if not idx:
        print("(no mirrored sessions)")
        return 0
    rc = 0
    for sid in sorted(idx.keys(), key=lambda s: idx[s].get("updated") or 0):
        rc |= do_restore(sid, args.new_ids, args.dir, args.dry_run, args.force)
    return rc


def cmd_log(args):
    p = os.path.join(ROOT, f"{args.id}.events.jsonl")
    if not os.path.exists(p):
        die(f"no journal for {args.id}")
    with open(p, "rb") as f:
        f.seek(0, os.SEEK_END)
        size = f.tell()
        f.seek(max(0, size - 20000))
        data = f.read().decode("utf-8", "replace").splitlines()
    for line in data[-args.n:]:
        try:
            ev = json.loads(line)
            print(f"{ev.get('type', '?'):32} {human_time(ev.get('created'))}  {json.dumps(ev.get('data', {}))[:120]}")
        except Exception:
            print(line[:160])
    return 0


def cmd_git_log(args):
    try:
        subprocess.run(["git", "-C", ROOT, "log", "--oneline", f"-{args.n}"])
        return 0
    except Exception as e:
        die(f"git: {e}")


def cmd_commit(args):
    """Force a git checkpoint of the mirror."""
    try:
        subprocess.run(["git", "-C", ROOT, "add", "-A"], check=True, capture_output=True)
        r = subprocess.run(
            ["git", "-C", ROOT, "commit", "-q", "-m",
             f"mirror manual {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}"],
            capture_output=True, text=True)
        if r.returncode == 0:
            head = subprocess.run(["git", "-C", ROOT, "log", "-1", "--oneline"],
                                  capture_output=True, text=True).stdout.strip()
            print(f"commit created: {head}")
        else:
            print("nothing to commit")
        return 0
    except Exception as e:
        die(f"git: {e}")


def main():
    ap = argparse.ArgumentParser(prog="opencode-mirror", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")

    sub.add_parser("list", help="list mirrored sessions").set_defaults(func=cmd_list)
    sub.add_parser("status", help="mirror summary").set_defaults(func=cmd_status)

    v = sub.add_parser("verify", help="validate snapshots")
    v.add_argument("id", nargs="?")
    v.set_defaults(func=cmd_verify)

    def add_restore_opts(p):
        p.add_argument("--new-ids", action="store_true", help="generate fresh IDs")
        p.add_argument("--dir", help="target directory")
        p.add_argument("--dry-run", action="store_true")
        p.add_argument("--force", action="store_true",
                       help="import even if the session already exists")

    r = sub.add_parser("restore", help="restore one session")
    r.add_argument("id")
    add_restore_opts(r)
    r.set_defaults(func=cmd_restore)

    ra = sub.add_parser("restore-all", help="restore every session")
    add_restore_opts(ra)
    ra.set_defaults(func=cmd_restore_all)

    lg = sub.add_parser("log", help="event journal of a session")
    lg.add_argument("id")
    lg.add_argument("-n", type=int, default=30)
    lg.set_defaults(func=cmd_log)

    gl = sub.add_parser("git-log", help="mirror commit history")
    gl.add_argument("-n", type=int, default=20)
    gl.set_defaults(func=cmd_git_log)

    cm = sub.add_parser("commit", help="force a git checkpoint of the mirror")
    cm.set_defaults(func=cmd_commit)

    args = ap.parse_args()
    if not getattr(args, "func", None):
        ap.print_help()
        return 0
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
